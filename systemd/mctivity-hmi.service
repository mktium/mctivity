[Unit]
Description=MCTIVITY Web HMI
After=network-online.target mctivity-motiond.service
Wants=network-online.target
Requires=mctivity-motiond.service

[Service]
Type=simple
User=mctivity
Group=mctivity
WorkingDirectory=/opt/mctivity/mctivity_hmi
Environment=MCTIVITY_PROFILE=full
Environment=MCTIVITY_WEB_HOST=127.0.0.1
Environment=MCTIVITY_WEB_PORT=2015
Environment=MCTIVITY_UI_STATE_PATH=/var/lib/mctivity/mctivity_hmi_state.json
EnvironmentFile=-/etc/mctivity/hmi.env
EnvironmentFile=-/etc/mctivity/axis.env
ExecStart=/usr/bin/env python3 /opt/mctivity/mctivity_hmi/mctivity_hmi.py
Restart=always
RestartSec=2
TimeoutStopSec=10s
StateDirectory=mctivity
# Required for the constrained sudoers poweroff command.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
